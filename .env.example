# SmartComp Engine environment template
#
# Copy this file to `.env`, then fill in your own credentials:
#   Copy-Item .env.example .env
#
# Never commit `.env` or real API keys.

# LLM -------------------------------------------------------------------------
# Supported provider for the current client. Leave MIMO_API_KEY empty to use
# the local rule engine; the frontend will clearly show that fallback mode.
LLM_PROVIDER=mimo
MIMO_API_KEY=
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro
# Keep model requests direct by default. Set true only when MiMo must use the
# machine's HTTP(S)_PROXY environment variables.
MIMO_USE_SYSTEM_PROXY=false

# Web search ------------------------------------------------------------------
# Required only for Tavily-backed live web search.
TAVILY_API_KEY=
SEARCH_RECENCY=month
SEARCH_DELAY_SECONDS=2.0
SEARCH_MAX_OUTPUT_TOKENS=2048

# Workflow --------------------------------------------------------------------
USE_LANGGRAPH_WORKFLOW=1
LANGGRAPH_NODE_RETRIES=2

# Audit logs ------------------------------------------------------------------
# Set to false to avoid archiving full prompts in llm_logs.json.
ARCHIVE_PROMPTS=true
